# ==============================================================================
# AI Tech Consultant — Environment Configuration (.env.example)
# Copy to .env and configure values before starting services.
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL with pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_tech_consultant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tech_consultant

# Anthropic Claude API
# Note: For automated test runs and local offline development, set USE_MOCK_LLM=true.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_EVAL_MODEL=claude-3-5-haiku-20241022
USE_MOCK_LLM=false

# Task 1: Knowledge Brain Configuration
TASK1_PORT=8001
TASK1_API_KEY=kb_dev_secret_key_12345
KNOWLEDGE_BRAIN_URL=http://localhost:8001
CRAWL_MAX_PAGES=20
CRAWL_CONCURRENCY=2
CRAWL_DELAY_SECONDS=0.5
USER_AGENT=AITechConsultantBot/1.0 (+https://businesslabs.ai/bot)

# Task 2: Inbox Agent Configuration
TASK2_PORT=8002
TASK2_API_KEY=inbox_dev_secret_key_12345
AUTONOMY_THRESHOLD=20
SIMULATE_EMAIL_SEND=true

# Task 3: Meeting to Scope Configuration
TASK3_PORT=8003
TASK3_API_KEY=scope_dev_secret_key_12345

# Frontend
FRONTEND_PORT=3000
VITE_TASK1_URL=http://localhost:8001
VITE_TASK2_URL=http://localhost:8002
VITE_TASK3_URL=http://localhost:8003
